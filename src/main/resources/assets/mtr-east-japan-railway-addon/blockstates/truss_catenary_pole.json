{
  "multipart": [

    { "when": { "up": "true" }, "apply": { "model": "mtr-east-japan-railway-addon:block/truss_catenary_pole_post" } },
    { "when": { "down": "true" }, "apply": { "model": "mtr-east-japan-railway-addon:block/truss_catenary_pole_post" } },
    { "when": { "up": "false", "down": "false", "north": "none", "east": "none", "south": "none", "west": "none" },
      "apply": { "model": "mtr-east-japan-railway-addon:block/truss_catenary_pole_post" } },

    { "when": { "north": "pole" }, "apply": { "model": "mtr-east-japan-railway-addon:block/truss_catenary_pole_beam" } },
    { "when": { "east": "pole" },  "apply": { "model": "mtr-east-japan-railway-addon:block/truss_catenary_pole_beam", "y": 90 } },
    { "when": { "south": "pole" }, "apply": { "model": "mtr-east-japan-railway-addon:block/truss_catenary_pole_beam_0", "y": 180 } },
    { "when": { "west": "pole" },  "apply": { "model": "mtr-east-japan-railway-addon:block/truss_catenary_pole_beam_0", "y": 270 } },

    { "when": { "north": "four_light" },  "apply": { "model": "mtr-east-japan-railway-addon:block/signal_pole_arm" } },
    { "when": { "north": "three_light" }, "apply": { "model": "mtr-east-japan-railway-addon:block/signal_pole_arm_3light" } },
    { "when": { "north": "two_light" },   "apply": { "model": "mtr-east-japan-railway-addon:block/signal_pole_arm_2light" } },
    { "when": { "north": "switching" },   "apply": { "model": "mtr-east-japan-railway-addon:block/signal_pole_arm_switching" } },

    { "when": { "east": "four_light" },  "apply": { "model": "mtr-east-japan-railway-addon:block/signal_pole_arm", "y": 90 } },
    { "when": { "east": "three_light" }, "apply": { "model": "mtr-east-japan-railway-addon:block/signal_pole_arm_3light", "y": 90 } },
    { "when": { "east": "two_light" },   "apply": { "model": "mtr-east-japan-railway-addon:block/signal_pole_arm_2light", "y": 90 } },
    { "when": { "east": "switching" },   "apply": { "model": "mtr-east-japan-railway-addon:block/signal_pole_arm_switching", "y": 90 } },

    { "when": { "south": "four_light" },  "apply": { "model": "mtr-east-japan-railway-addon:block/signal_pole_arm", "y": 180 } },
    { "when": { "south": "three_light" }, "apply": { "model": "mtr-east-japan-railway-addon:block/signal_pole_arm_3light", "y": 180 } },
    { "when": { "south": "two_light" },   "apply": { "model": "mtr-east-japan-railway-addon:block/signal_pole_arm_2light", "y": 180 } },
    { "when": { "south": "switching" },   "apply": { "model": "mtr-east-japan-railway-addon:block/signal_pole_arm_switching", "y": 180 } },

    { "when": { "west": "four_light" },  "apply": { "model": "mtr-east-japan-railway-addon:block/signal_pole_arm", "y": 270 } },
    { "when": { "west": "three_light" }, "apply": { "model": "mtr-east-japan-railway-addon:block/signal_pole_arm_3light", "y": 270 } },
    { "when": { "west": "two_light" },   "apply": { "model": "mtr-east-japan-railway-addon:block/signal_pole_arm_2light", "y": 270 } },
    { "when": { "west": "switching" },   "apply": { "model": "mtr-east-japan-railway-addon:block/signal_pole_arm_switching", "y": 270 } },

    { "when": { "up": "true", "north": "pole" }, "apply": { "model": "mtr-east-japan-railway-addon:block/catenary_pole_bracket" } },
    { "when": { "down": "true", "north": "pole" }, "apply": { "model": "mtr-east-japan-railway-addon:block/catenary_pole_bracket" } },

    { "when": { "up": "true", "east": "pole" }, "apply": { "model": "mtr-east-japan-railway-addon:block/catenary_pole_bracket", "y": 90 } },
    { "when": { "down": "true", "east": "pole" }, "apply": { "model": "mtr-east-japan-railway-addon:block/catenary_pole_bracket", "y": 90 } },

    { "when": { "up": "true", "south": "pole" }, "apply": { "model": "mtr-east-japan-railway-addon:block/catenary_pole_bracket", "y": 180 } },
    { "when": { "down": "true", "south": "pole" }, "apply": { "model": "mtr-east-japan-railway-addon:block/catenary_pole_bracket", "y": 180 } },

    { "when": { "up": "true", "west": "pole" }, "apply": { "model": "mtr-east-japan-railway-addon:block/catenary_pole_bracket", "y": 270 } },
    { "when": { "down": "true", "west": "pole" }, "apply": { "model": "mtr-east-japan-railway-addon:block/catenary_pole_bracket", "y": 270 } }
  ]
}