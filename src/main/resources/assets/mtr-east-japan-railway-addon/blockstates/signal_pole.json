    { "when": { "north": "two_light" },   "apply": { "model": "mtr-east-japan-railway-addon:block/signal_pole_arm_2light" } },
    { "when": { "north": "switching" },   "apply": { "model": "mtr-east-japan-railway-addon:block/signal_pole_arm_switching" } },
    { "when": { "north": "crossing_signmark" },   "apply": { "model": "mtr-east-japan-railway-addon:block/signal_pole_arm_2light" } },

    { "when": { "east": "four_light" },  "apply": { "model": "mtr-east-japan-railway-addon:block/signal_pole_arm", "y": 90 } },
