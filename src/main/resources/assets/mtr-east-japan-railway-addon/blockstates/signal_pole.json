{
  "multipart": [
    { "apply": { "model": "mtr-east-japan-railway-addon:block/signal_pole_post" } },

    { "when": { "north": "four_light" },  "apply": { "model": "mtr-east-japan-railway-addon:block/signal_pole_arm" } },
